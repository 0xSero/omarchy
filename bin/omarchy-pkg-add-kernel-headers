#!/bin/bash

# omarchy:summary=Install headers for the supported system kernel
# omarchy:hidden=true
# omarchy:requires-sudo=true

# Inspect the target's packages: uname reports the live ISO kernel in a chroot.
# A retained stock kernel must not take precedence over the Omarchy kernel.
if omarchy-pkg-present linux-t2; then
  omarchy-pkg-add linux-t2-headers
else
  omarchy-pkg-add linux-omarchy-headers
fi
